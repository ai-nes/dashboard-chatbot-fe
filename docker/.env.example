# =============================================================================
# FPT Admission Dashboard — Environment variables
# Copy: cp docker/.env.example docker/.env
# =============================================================================

# -----------------------------------------------------------------------------
# Application (dev trên host — task dev)
# -----------------------------------------------------------------------------
PORT=3333

# API URL — bake vào bundle khi build
NEXT_PUBLIC_API_BASE_URL=http://localhost:2222

# Production: FE ở Vercel (domain qna.faip.pro). Đặt NEXT_PUBLIC_API_BASE_URL =
# https://qna-api.faip.pro trong Vercel → Settings → Environment Variables.
# File docker/ chỉ để self-host fallback. Xem DEPLOYMENT.md.
